{
  "name": "PredixFinance",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npm run android:dev:debug",
    "android:dev:debug": "ENVFILE=.env.development react-native run-android --mode devDebug --appIdSuffix dev",
    "android:dev:release": "ENVFILE=.env.development react-native build-android --mode devRelease",
    "android:prod:debug": "ENVFILE=.env.production react-native run-android --mode prodDebug",
    "android:prod:release": "ENVFILE=.env.production react-native build-android --mode prodRelease",
    "ios": "npm run ios:dev:debug",
    "ios:dev:debug": "ENVFILE=.env.development react-native run-ios --mode Debug",
    "ios:dev:release": "ENVFILE=.env.development react-native build-ios --mode Release",
    "ios:prod:debug": "ENVFILE=.env.production react-native run-ios --mode Debug",
    "ios:prod:release": "ENVFILE=.env.production react-native build-ios --mode Release",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-vector-icons/ant-design": "^13.0.0",
    "@react-native-vector-icons/feather": "^13.0.0",
    "@react-native-vector-icons/fontawesome": "^13.0.0",
    "@react-native-vector-icons/ionicons": "^13.0.0",
    "@react-native-vector-icons/lucide": "^13.1.2",
    "@react-native-vector-icons/material-icons": "^13.0.0",
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@reown/appkit-ethers-react-native": "^2.0.6",
    "@reown/appkit-react-native": "^2.0.6",
    "@walletconnect/react-native-compat": "^2.23.10",
    "ethers": "^6.17.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-app-auth": "^8.4.1",
    "react-native-config": "^1.6.1",
    "react-native-flash-message": "^0.4.2",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-asset": "^2.3.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
